        "sfx": "pop_hi",
        "rules": {
          "density": {
            "per_10s": 2,
            "min_gap_s": 0.5
          },
          "duration_s": [
            2.5,
            6.0
          ],
          "never": [
            "over_face",
            "over_captions"
          ],
          "when": "The first time each person speaks. Their name (and a role only if it matters). Top pane - beside the face, about [0.22, 0.3]; bottom pane - just under the seam captions, about [0.72, 0.625] (lower down and further right is under the apps' buttons); never on the seam."
        }
      },
      "reaction_sticker": {
        "kind": "popup",
