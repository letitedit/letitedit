          "never": [
            "over_face",
            "over_captions"
          ],
          "when": "A real laugh or gasp on screen; put it in that person's pane, beside their face."
        }
      },
      "key_line": {
        "kind": "text_pop",
        "about": "The one line worth quoting, a few words big in that speaker's colour.",
        "size": 0.6,
        "font": "heading",
        "fill": "secondary",
        "stroke": "dark",
        "stroke_width": 12,
        "tilt": 0,
        "in": "pop",
        "out": "fade",
