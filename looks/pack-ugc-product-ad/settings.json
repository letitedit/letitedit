    },
    "text": {
      "font": "heading",
      "size": 80,
      "fill": "dark",
      "outline": null
    },
    "graphics": {
      "word_captions": {
        "style": "pop",
        "font": "captions",
        "size": 44,
        "fill": "light",
        "highlight": "secondary",
