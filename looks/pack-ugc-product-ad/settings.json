    "format": "letitedit-style/3",
    "name": "UGC Product Ad",
    "description": "A 20-45 s vertical ad that looks like a person showing a thing they use - native text and captions, quick proof, one call to action.",
    "colors": {
      "primary": "#FFFFFF",
      "secondary": "#FFE14D",
      "accent": "#FF4D6D",
