          "placement": {
            "avoid": [
              "face",
              "captions",
              "covered"
            ]
          },
          "duration_s": [
            0.5,
            1.4
          ],
          "never": [
            "over_face"
          ],
          "when": "Every 5-8 s something new is promised or goes wrong; one or two words, never the same twice in a row."
        }
