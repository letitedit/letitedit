            "per_min": 2,
            "min_gap_s": 10.0
          },
          "duration_s": [
            5.0,
            60.0
          ],
          "never": [
            "outside_safe_zone"
          ],
          "when": "Over an attempt or the whole run (params from_s, to_s, label like \"TIME LEFT\" or \"DAY\"). Only a real limit or the video's own clock - never a fake deadline; say so in the brief."
