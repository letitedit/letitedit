    },
    "hook": {
      "max_s": 3.0,
      "approaches": [
        "result_first",
        "question",
        "stakes",
        "number",
        "quote",
        "mid_action"
      ],
      "text": {
        "max_words": 6,
        "case": "upper",
        "position": "top",
        "size": 0.82,
        "fill": "secondary",
        "stroke": "dark"
      },
      "rules": "The first frame is the most interesting moment, said or shown; the hook text says the promise in under six words; no greeting, no \"in this video\" [JH]. Hook and the line that says what is coming are done by about 3 s.",
