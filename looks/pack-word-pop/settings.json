    "effects": {
      "thing_pop": {
        "kind": "popup",
        "about": "The thing being talked about pops up beside the speaker (an emoji or the person's own picture of it).",
        "size": 0.26,
        "in": "pop",
        "out": "shrink",
        "hold_s": 1.1,
        "outline": 10,
        "sfx": "pop",
        "rules": {
          "triggers": [
            "mention",
            "brand",
            "list_item"
          ],
          "density": {
            "per_10s": 2,
            "min_gap_s": 2.0
          },
          "placement": {
            "zone": "opposite_face",
            "avoid": [
              "face",
              "captions",
              "covered"
            ]
          },
          "duration_s": [
            0.9,
            2.2
          ],
          "never": [
            "over_face",
            "over_captions"
          ],
          "when": "A concrete thing the viewer could picture (a tool, a part, a product, a food). Not for abstract words."
        }
      },
      "number_pop": {
        "kind": "text_pop",
        "about": "A number or price said aloud appears as big text above the captions.",
        "size": 0.5,
        "fill": "secondary",
        "hold_s": 1.0,
        "sfx": "ding",
        "rules": {
          "triggers": [
            "number"
          ],
          "density": {
            "per_10s": 1,
            "min_gap_s": 3.0
          },
          "placement": {
            "zone": "above_captions",
            "avoid": [
              "face",
              "captions",
              "covered"
            ]
          },
          "duration_s": [
            0.8,
            1.8
          ],
          "never": [
            "over_face"
          ],
          "when": "Prices, counts, times and measurements that matter to the story; write them as numerals ($12, 3 hrs)."
        }
      },
      "emphasis_word": {
        "kind": "text_pop",
        "about": "One word the speaker leans on, big in the middle, for a beat.",
        "size": 0.66,
        "fill": "light",
        "stroke": "dark",
        "hold_s": 0.7,
        "sfx": "pop",
        "rules": {
          "triggers": [
            "emphasis",
            "punchline",
            "reveal"
          ],
          "density": {
            "per_min": 6,
            "min_gap_s": 4.0
          },
          "placement": {
            "zone": "above_captions",
            "avoid": [
              "face",
              "captions",
              "covered"
            ]
          },
          "duration_s": [
            0.6,
            1.4
          ],
          "never": [
            "over_face"
          ],
          "when": "The one word that carries the sentence (\"NEVER\", \"FREE\", \"GONE\"). At most one per sentence."
        }
      },
      "punch_in": {
        "kind": "zoom_punch",
        "about": "A quick push-in that holds until the next cut (115%, inside the 110-120% that keeps the picture sharp [MON]).",
        "scale": 1.15,
        "ramp_s": 0.06,
        "rules": {
          "triggers": [
            "emphasis",
            "punchline",
            "question",
            "topic_change",
            "reveal"
          ],
          "density": {
            "per_10s": 2,
            "min_gap_s": 2.0
          },
          "when": "On the stressed word of a line, the result being heard or seen, or to restart energy on a long take. Alternate punched and not punched (two framings [MON]); five punch-ins in a row stop reading as a change."
        }
      },
      "shake_hit": {
        "kind": "shake",
        "about": "A short camera shake with a low hit, for a punchline or a reveal.",
        "amount": 0.45,
        "len": 0.3,
        "sfx": "thump",
        "rules": {
          "triggers": [
            "punchline",
            "reveal",
            "reaction"
          ],
          "density": {
            "per_min": 3,
            "min_gap_s": 6.0
          },
          "when": "Only for a real surprise or a joke's last word; it loses its effect when used often."
        }
      },
      "whoosh_cut": {
        "kind": "whoosh",
        "about": "A whoosh that lands on a cut between topics.",
        "sfx": "whoosh",
        "sfx_offset_s": -0.14,
        "rules": {
          "triggers": [
            "cut",
            "topic_change"
          ],
          "density": {
            "per_min": 6,
            "min_gap_s": 4.0
          },
          "when": "On a change of topic or a jump in time, not on every cut."
        }
      },
      "flash_cut": {
        "kind": "flash",
        "about": "A quick white flash over a cut to a reveal.",
        "color": "light",
        "len": 0.2,
        "opacity": 0.75,
        "sfx": "whoosh",
        "sfx_offset_s": -0.1,
        "rules": {
          "triggers": [
            "reveal",
            "topic_change"
          ],
          "density": {
            "per_min": 2,
            "min_gap_s": 10.0
          },
          "when": "The before/after or the result being shown for the first time."
        }
      },
      "place_tag": {
        "kind": "location",
        "about": "A place tag when a place is named.",
        "params": {
          "position": "top-left"
        },
        "len": 3.0,
        "rules": {
          "triggers": [
            "place"
          ],
          "density": {
            "per_min": 2,
            "min_gap_s": 15.0
          },
          "placement": {
            "avoid": [
              "covered"
            ]
          }
        }
      },
      "cutaway": {
        "kind": "broll",
        "about": "A short cutaway to the thing being described while the voice carries on.",
        "fit": "cover",
        "len": 1.8,
        "rules": {
          "triggers": [
            "mention",
            "list_item"
          ],
          "density": {
            "per_10s": 1,
            "min_gap_s": 4.0
          },
          "duration_s": [
            1.0,
            4.0
          ],
          "never": [
            {
              "first_s": 2.0
            }
          ],
          "when": "When there is footage of the exact thing said, starting within 1.5 s of the word and 3-5 s at most [MON]; never cut away from a punchline or a reaction."
        }
      }
    },
    "fx": {
      "track": "Effects",
      "sfx_track": "Effect sounds",
      "broll_track": "B-roll",
      "density": {
        "per_10s": 4,
