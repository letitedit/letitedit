    "taste": "",
    "label": "Podcast episode",
    "summary": "A full video podcast or interview - the best moment as a cold open, the picture on whoever is talking, the wide shot to reset, names and chapters.",
    "kind": "long",
    "tags": [
      "podcast",
      "interview",
      "conversation",
      "multicam",
      "talk show",
      "long form",
