        },
        {
          "url": "https://blueboxdigital.com/podcast-video-production/",
          "title": "BlueBox video podcast production",
          "used_for": "a cut on nearly every speaker change, wide for interplay and singles for stories, punch-in angles, intro under 20 s, -16 / -14 LUFS, 60 min to 45-50 min",
          "licence": "none found (numbers only)"
        },
        {
          "url": "https://slicecut.io/guides/how-to-edit-a-video-podcast/",
          "title": "slicecut video podcast editing",
          "used_for": "speaker, listener, wide; music on intro, outro and transitions only",
          "licence": "none found (numbers only)"
        }
      ],
      "notes": "One wide camera becomes several angles by punching in on each person (the recipe says how); no source gives how often to switch angles (the MIT recipe says so), so the picture follows the talk. Tags in ..\\SOURCES.md."
    }
