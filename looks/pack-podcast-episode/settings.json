    ],
    "preview": "preview.jpg",
    "recipe": "recipe.md",
    "credits": [
      {
        "file": "preview.jpg",
        "source": "drawn by tools\\styles\\preview.py --drawn episode: the style's layout with plain silhouettes (no people), in its own type and colours",
        "licence": "letitedit's own (drawn)"
      }
    ],
    "effects": {
      "show_title": {
        "kind": "graphic",
        "about": "The show's name and the episode on the wide shot, after the cold open (an intro under 20 s) [BBX].",
        "template": "title_card",
        "len": 4.0,
        "sfx": "whoosh",
        "sfx_offset_s": -0.51,
        "rules": {
          "triggers": [
            "hook",
            "topic_change"
          ],
          "density": {
            "per_min": 1
          },
          "duration_s": [
            3.0,
            6.0
          ],
          "when": "Once, right after the cold open (params title = the show, subtitle = the episode)."
        }
      },
      "name_tag": {
        "kind": "graphic",
        "about": "A person's name and why they're here, at their first appearance and again after a long break [AVE].",
        "template": "lower_third",
        "len": 5.0,
        "sfx": null,
        "rules": {
          "triggers": [
            "mention"
          ],
          "density": {
            "per_min": 2,
            "min_gap_s": 8.0
          },
          "duration_s": [
            3.5,
            6.0
          ],
          "never": [
            "overlapping"
          ],
          "when": "The first time each person talks on their own shot (params title = name, subtitle = role); again after about 15 minutes."
        }
      },
      "chapter": {
        "kind": "graphic",
        "about": "The chapter's number and name on a band over the wide shot as a new topic starts.",
        "template": "chapter_card",
        "len": 3.5,
        "sfx": "swipe",
        "rules": {
          "triggers": [
            "topic_change"
          ],
          "density": {
            "per_min": 1,
            "min_gap_s": 30.0
          },
          "duration_s": [
            2.5,
            4.5
          ],
          "when": "One per topic, matching the chapter markers (the first at 0:00, at least three, each at least 10 s) [AVE]; params number, title."
        }
      },
      "pull_quote": {
        "kind": "text_pop",
        "about": "The line that sums up a chapter, in a serif italic beside the speaker, fading in and out.",
        "size": 0.48,
        "zone": "opposite_face",
        "font": "quote",
        "fill": "light",
        "stroke": null,
        "stroke_width": 0,
        "tilt": 0,
        "shadow": true,
        "in": "fade",
        "out": "fade",
        "in_s": 0.5,
        "out_s": 0.5,
        "hold_s": 3.0,
        "sfx": null,
        "rules": {
          "triggers": [
            "emphasis",
            "reveal",
            "punchline"
          ],
          "density": {
            "per_min": 1,
            "min_gap_s": 120.0
          },
          "placement": {
            "zone": "opposite_face",
            "avoid": [
              "face",
              "captions"
            ]
          },
          "duration_s": [
            2.5,
            5.0
          ],
          "never": [
            "over_face",
            "overlapping"
          ],
          "when": "At most one per chapter - the speaker's exact words, shortened, never a new claim."
        }
      },
      "coming_up": {
        "kind": "graphic",
        "about": "A small \"Coming up\" label on the cold open, so the viewer knows it's from later.",
        "template": "badge",
        "params": {
          "position": "top-left"
        },
        "len": 3.0,
        "sfx": null,
        "rules": {
          "triggers": [
            "hook"
          ],
          "density": {
            "per_min": 1
          },
          "when": "Only over a cold open taken from later in the episode."
        }
      },
      "reset_push": {
        "kind": "zoom_punch",
        "about": "A slow push on the wide shot (104% over 4 s) after a long single, so the reset still moves.",
        "scale": 1.04,
        "ramp_s": 4.0,
        "rules": {
          "triggers": [
            "topic_change",
            "pause"
          ],
          "density": {
            "per_min": 2,
            "min_gap_s": 30.0
          },
          "when": "On the wide that re-establishes the room after a topic change [AVE]."
        }
      },
      "cutaway": {
        "kind": "broll",
        "about": "A shot of what they're talking about (a place, an object, a photo) over the voice.",
        "fit": "blur_pad",
        "len": 3.5,
        "sfx": null,
        "rules": {
          "triggers": [
            "mention",
            "place"
          ],
          "density": {
            "per_min": 2,
            "min_gap_s": 20.0
          },
          "duration_s": [
            2.0,
            6.0
          ],
          "when": "Only when there's a shot of the exact thing; never over a laugh, an emotional answer or a reaction."
        }
      }
    },
    "fx": {
      "track": "Effects",
      "sfx_track": "Effect sounds",
      "broll_track": "B-roll",
      "density": {
        "per_10s": 2,
        "per_min": 4,
        "min_gap_s": 3.0
      },
      "safe_zone": null,
      "never": [
        "overlapping"
      ],
      "rhythm": "The picture follows the talk - the speaker for most of a turn, a reaction when it says something, the wide to reset; graphics only for names, chapters and one quote a chapter at most."
    },
    "popups": {
      "track": null,
      "sfx_track": null,
      "min_gap_s": 10.0,
      "max_total": null,
      "entries": []
    },
    "hook": {
      "max_s": 60.0,
      "approaches": [
        "quote",
        "stakes",
        "question"
      ],
      "text": {
        "max_words": 6,
        "case": "as_said",
        "position": "bottom",
        "size": 0.4,
        "fill": "light",
        "stroke": null,
        "stroke_width": 0,
        "font": "heading"
      },
      "rules": "A cold open of 15-60 s - the best exchange from later in the talk, with its own setup and payoff [AVE] - then the intro and show title in under 20 s [BBX]. No \"welcome back to the show\" before the cold open.",
      "avoid": [
        "a long intro",
        "greetings first",
        "a montage of every clip"
      ]
    },
    "broll": {
      "amount": "some",
      "kinds": [],
      "favorites": "",
      "notes": ""
    },
    "shots": {
      "framing": "medium",
      "camera": "handheld",
      "punch_ins": "some",
      "notes": ""
    },
    "signature": {
      "touches": []
    },
