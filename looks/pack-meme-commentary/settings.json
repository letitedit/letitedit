    "taste": "",
    "label": "Meme commentary",
    "summary": "Meme-format comedy - a caption bar over the clip, freeze frames, snap zooms with a boom, reaction emoji and sound stings, out on the punchline.",
    "kind": "short",
    "tags": [
      "meme",
      "comedy",
      "commentary",
      "reaction",
      "funny",
      "freeze frame",
      "caption bar",
      "sound effects",
      "shorts"
    ],
    "preview": "preview.jpg",
    "recipe": "recipe.md",
    "credits": [
      {
        "file": "preview.jpg",
        "source": "Original preview imagery; hands, objects, places and titles only",
        "licence": "Original letitedit footage: hands, objects, places and titles only; no faces"
      }
    ],
    "effects": {
      "setup_bar": {
        "kind": "graphic",
        "about": "The setup line on a white bar near the top (\"me after fixing the A/C once:\"), lowercase, there while the clip plays out [GEN the caption-meme format].",
        "template": "caption_bar",
        "len": 4.0,
        "sfx": null,
        "rules": {
          "triggers": [
            "hook",
            "topic_change"
          ],
          "density": {
            "per_min": 5,
            "min_gap_s": 3.0
          },
          "duration_s": [
            2.0,
            12.0
          ],
          "never": [
            "outside_safe_zone"
          ],
          "when": "Every bit starts with one; it says the situation, never the punchline. Params text, lowercase, 12 words at most. Under the phone app's top bar (the pack's margin)."
        }
      },
      "snap_zoom": {
        "kind": "zoom_punch",
        "about": "A snap zoom to 145% on a face or the thing at the punchline, with a deep boom.",
        "scale": 1.45,
        "ramp_s": 0.04,
        "len": 1.1,
        "sfx": "boom",
        "rules": {
          "triggers": [
            "punchline",
            "reaction",
            "reveal"
          ],
          "density": {
            "per_min": 4,
            "min_gap_s": 4.0
          },
          "duration_s": [
            0.6,
            1.6
          ],
          "when": "The look, the line or the moment the joke turns on; focus on it. Two in a row kill it - rotate with freeze and shake."
        }
      },
      "impact_text": {
        "kind": "text_pop",
        "about": "Classic meme text - white capitals with a black edge, slammed in under the setup bar (\"NOT AGAIN\").",
        "size": 0.62,
        "font": "heading",
        "fill": "light",
        "stroke": "dark",
        "stroke_width": 14,
        "tilt": 0,
        "position": [
          0.5,
          0.37
        ],
        "in": "pop",
        "out": "none",
        "hold_s": 1.0,
        "sfx": null,
        "rules": {
          "triggers": [
            "punchline",
            "reaction"
          ],
          "density": {
            "per_min": 6,
            "min_gap_s": 4.0
          },
          "placement": {
            "avoid": [
              "face",
              "covered"
            ]
          },
          "duration_s": [
            0.7,
            1.8
          ],
          "never": [
            "over_face",
            "overlapping"
          ],
          "when": "The reaction in one to three words, or the speaker's own punch word; once per bit."
        }
      },
      "reaction_emoji": {
        "kind": "popup",
        "about": "A big reaction emoji on the joke (skull, crying-laughing, clown, eyes), at the side under the setup bar.",
        "size": 0.26,
        "position": [
          0.68,
          0.47
        ],
        "in": "pop",
        "out": "pop",
        "hold_s": 0.9,
        "wiggle": 6,
        "shadow": true,
        "sfx": "pop",
        "rules": {
          "triggers": [
            "reaction",
            "punchline"
          ],
          "density": {
            "per_min": 5,
            "min_gap_s": 4.0
          },
          "placement": {
            "avoid": [
              "captions",
              "covered"
            ]
          },
          "duration_s": [
            0.6,
            1.4
          ],
          "never": [
            "over_captions"
          ],
          "when": "The audience's reaction, not the speaker's; one at a time; clear of the setup bar and the meme text."
        }
      },
      "shake_hit": {
        "kind": "shake",
        "about": "A short hard shake with a bonk.",
        "amount": 0.7,
        "len": 0.3,
        "sfx": "bonk",
        "rules": {
          "triggers": [
            "punchline",
            "reaction"
          ],
          "density": {
            "per_min": 4,
            "min_gap_s": 5.0
          },
          "when": "Something breaks, falls, or a line hits like a slap."
        }
      },
      "scratch_stop": {
        "kind": "sfx",
        "about": "A record scratch where the music stops dead (the freeze-frame \"yep, that's me\" moment).",
        "sfx": "scratch",
        "sfx_offset_s": -0.1,
        "rules": {
          "triggers": [
            "reveal",
            "punchline",
            "topic_change"
          ],
          "density": {
            "per_min": 2,
            "min_gap_s": 12.0
          },
          "when": "On a freeze frame or the turn; the music is cut at the same frame."
        }
      },
      "fail_sting": {
        "kind": "sfx",
        "about": "A sad trombone on a real fail.",
        "sfx": "trombone",
        "sfx_gain_db": -12,
        "rules": {
          "triggers": [
            "reaction",
            "reveal"
          ],
          "density": {
            "per_min": 1
          },
          "when": "Something really went wrong on camera; never on a success."
        }
      },
      "rimshot": {
        "kind": "sfx",
        "about": "A ba-dum-tss after a pun or a self-own.",
        "sfx": "rimshot",
        "rules": {
          "triggers": [
            "punchline"
          ],
          "density": {
            "per_min": 1
          },
          "when": "After the line, never under it."
        }
      },
      "crowd_laugh": {
        "kind": "sfx",
        "about": "A short audience laugh after a joke that lands.",
        "sfx": "laugh",
        "sfx_gain_db": -16,
        "rules": {
          "triggers": [
            "punchline",
            "reaction"
          ],
          "density": {
            "per_min": 2,
            "min_gap_s": 15.0
          },
          "when": "After the last word, never over it; once or twice a video."
        }
      },
      "time_card": {
        "kind": "graphic",
        "about": "A full-screen time card (\"9 DAYS LATER\") in a cartoon face on purple, 1.5 s, with a slide whistle.",
        "template": "title_card",
        "len": 1.6,
        "sfx": "whistle",
        "rules": {
          "triggers": [
            "topic_change"
          ],
          "density": {
            "per_min": 2,
            "min_gap_s": 10.0
          },
          "duration_s": [
            1.2,
            2.2
          ],
          "when": "A jump in time that the joke needs (only true times, from the footage's dates or the person); params title."
        }
      },
      "win_sting": {
        "kind": "sfx",
        "about": "A ta-da on the (ironic or real) win.",
        "sfx": "tada",
        "rules": {
          "triggers": [
            "reveal",
            "ending"
          ],
          "density": {
            "per_min": 1
          },
          "when": "The payoff; a fanfare on a small win is the joke."
        }
      }
    },
    "fx": {
      "track": "Effects",
      "sfx_track": "Effect sounds",
      "broll_track": "B-roll",
      "density": {
        "per_10s": 8,
        "per_min": null,
        "min_gap_s": null
      },
      "safe_zone": "phone",
      "never": [
        "outside_safe_zone"
      ],
      "rhythm": "Setup clean, punchline loud - a freeze, a snap zoom, a boom and an emoji within half a second, then on."
    },
