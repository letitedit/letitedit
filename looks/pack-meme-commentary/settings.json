            "triggers": [
              "hook",
              "topic_change"
            ],
            "density": {
              "per_min": 5,
              "min_gap_s": 3.0
            },
            "duration_s": [
              2.0,
              12.0
            ],
            "never": [
              "outside_safe_zone"
            ],
            "when": "Every bit starts with one; it says the situation, never the punchline. Params text, lowercase, 12 words at most. Under the phone app's top bar (the pack's margin)."
          }
        },
        "snap_zoom": {
          "kind": "zoom_punch",
          "about": "A snap zoom to 145% on a face or the thing at the punchline, with a deep boom.",
