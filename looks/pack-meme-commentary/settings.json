            ],
            "density": {
              "per_min": 4,
              "min_gap_s": 4.0
            },
            "duration_s": [
              0.6,
              1.6
            ],
            "when": "The look, the line or the moment the joke turns on; focus on it. Two in a row kill it - rotate with freeze and shake."
          }
        },
        "impact_text": {
          "kind": "text_pop",
          "about": "Classic meme text - white capitals with a black edge, slammed in under the setup bar (\"NOT AGAIN\").",
