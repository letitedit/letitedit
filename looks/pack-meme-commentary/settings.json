        },
        "scratch_stop": {
          "kind": "sfx",
          "about": "A record scratch where the music stops dead (the freeze-frame \"yep, that's me\" moment).",
          "sfx": "scratch",
          "sfx_offset_s": -0.1,
          "rules": {
            "triggers": [
              "reveal",
              "punchline",
              "topic_change"
            ],
            "density": {
              "per_min": 2,
              "min_gap_s": 12.0
            },
            "when": "On a freeze frame or the turn; the music is cut at the same frame."
          }
        },
        "fail_sting": {
          "kind": "sfx",
          "about": "A sad trombone on a real fail.",
          "sfx": "trombone",
          "sfx_gain_db": -12,
          "rules": {
