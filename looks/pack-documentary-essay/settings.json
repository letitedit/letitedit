    "effects": {
      "act_title": {
        "kind": "graphic",
        "about": "A serif title on black between acts (3-4 s), with a low hit or in silence.",
        "template": "title_card",
        "len": 3.5,
        "sfx": "impact",
        "rules": {
          "triggers": [
            "topic_change",
            "hook"
          ],
          "density": {
            "per_min": 1,
            "min_gap_s": 40.0
          },
          "duration_s": [
            2.5,
            5.0
          ],
          "when": "The film's title after the cold open, and a new act's name; never more than one hit per film besides the title. Params title, subtitle."
        }
      },
      "date_card": {
        "kind": "popup",
        "about": "A date or a place in typewriter type, lower left, as a new scene starts; silent (no hit on every card). Date and place on two lines (\"SEPTEMBER 22\\nTHE BACK BEDROOM\").",
        "position": [
          0.2,
          0.86
        ],
        "size": 0.36,
        "font": "mono",
        "fill": "light",
        "stroke_width": 0,
        "shadow": true,
        "in": "fade",
        "out": "fade",
        "in_s": 0.4,
        "out_s": 0.5,
        "hold_s": 3.0,
        "sfx": null,
        "rules": {
          "triggers": [
            "place",
            "topic_change"
          ],
          "density": {
            "per_min": 2,
            "min_gap_s": 20.0
          },
          "duration_s": [
            2.5,
            5.0
          ],
          "never": [
            "overlapping"
          ],
          "when": "Where the viewer needs to know when or where (a new day, a new place, \"9 days later\") [modes]; upper case; always in time order. Give asset {text}."
        }
      },
      "name_tag": {
        "kind": "graphic",
        "about": "A person's name and why they matter, at their first appearance [modes].",
        "template": "lower_third",
        "len": 4.5,
        "sfx": null,
        "rules": {
          "triggers": [
            "mention"
          ],
          "density": {
            "per_min": 2,
            "min_gap_s": 20.0
          },
          "duration_s": [
            3.0,
            6.0
          ],
          "when": "The first time each person appears on camera; params title (name), subtitle (role or place)."
        }
      },
      "key_phrase": {
        "kind": "text_pop",
        "about": "A key phrase in serif italic beside the speaker (centred when no face is on screen), fading in and out [EDU key phrases only].",
        "size": 0.5,
        "zone": "opposite_face",
        "position": "center",
        "font": {
          "family": "Cormorant Garamond",
          "weight": 600,
          "italic": true
        },
        "fill": "light",
        "stroke_width": 0,
        "tilt": 0,
        "shadow": true,
        "in": "fade",
        "out": "fade",
        "in_s": 0.5,
        "out_s": 0.5,
        "hold_s": 2.5,
        "sfx": null,
        "rules": {
          "triggers": [
            "emphasis",
            "reveal"
          ],
          "density": {
            "per_min": 1,
            "min_gap_s": 45.0
          },
          "duration_s": [
            2.5,
            4.5
          ],
          "never": [
            "overlapping",
            "over_face"
          ],
          "when": "A phrase the film turns on, in the speaker's exact words [modes], twice or three times a film at most."
        }
      },
      "slow_push": {
        "kind": "zoom_punch",
        "about": "A slow push-in (106% over 4 s) on a held shot.",
        "scale": 1.06,
        "ramp_s": 4.0,
        "rules": {
          "triggers": [
            "emphasis",
            "reveal",
            "pause"
          ],
          "density": {
            "per_min": 3,
            "min_gap_s": 12.0
          },
          "when": "Holds on faces after a line that lands, on stills and on wide establishing shots [modes, hold after revelations]."
        }
      },
      "photo_click": {
        "kind": "sfx",
        "about": "A camera shutter on a still photo or a freeze.",
        "sfx": "shutter",
        "rules": {
          "triggers": [
            "cut"
          ],
          "density": {
            "per_min": 2,
            "min_gap_s": 15.0
          },
          "when": "Only when a still or a freeze-frame appears."
        }
      },
      "tension_bed": {
        "kind": "sfx",
        "about": "A low drone under a held, tense moment, with the music out.",
        "sfx": "drone",
        "rules": {
          "triggers": [
            "pause",
            "reveal"
          ],
          "density": {
            "per_min": 1
          },
          "when": "Once or twice per film, under the moment before the turn; never with music on top."
        }
      },
      "time_dissolve": {
        "kind": "transition",
        "about": "A slow dissolve where time passes (0.8 s).",
        "transition": {
          "type": "dissolve",
          "len": 0.8
        },
        "rules": {
          "triggers": [
            "topic_change"
          ],
          "density": {
            "per_min": 2,
            "min_gap_s": 20.0
          },
          "when": "Time passing or a change of place only [AOTC, modes]; hard cuts everywhere else."
        }
      },
      "cutaway": {
        "kind": "broll",
        "about": "An observational shot over the speaker's words.",
        "fit": "blur_pad",
        "len": 4.0,
        "sfx": null,
        "rules": {
          "triggers": [
            "mention",
            "place"
          ],
          "density": {
            "per_min": 4,
            "min_gap_s": 8.0
          },
          "duration_s": [
            3.0,
            8.0
          ],
          "when": "Behaviour and place over neutral stretches, never over the emotional line (keep the face) [modes]."
        }
      }
    },
    "fx": {
      "track": "Effects",
      "sfx_track": "Effect sounds",
      "broll_track": "B-roll",
      "density": {
        "per_10s": 2,
        "per_min": 6,
        "min_gap_s": 4.0
      },
      "safe_zone": null,
      "never": [
        "overlapping"
      ],
      "rhythm": "Long holds and slow pushes; a card where time or place changes; sound that punctuates; one silence."
    },
    "popups": {
      "track": null,
      "sfx_track": null,
      "min_gap_s": 5.0,
      "max_total": null,
      "entries": []
    },
    "hook": {
      "max_s": 15.0,
      "approaches": [
        "question",
        "stakes",
        "quote",
        "mid_action"
      ],
      "text": {
        "max_words": 6,
        "case": "as_said",
        "position": "bottom",
        "size": 0.45,
        "fill": "light",
        "stroke": null,
        "stroke_width": 0,
        "font": "heading"
      },
      "rules": "Pick the opening for the feel - contemplative (wordless shots of 3-5 s with sound layered in, the first line after the picture has set the place) or urgent (time, place and stakes in one breath) [modes]. Withhold the outcome, never the premise; the title comes after the cold open. No \"Hi, my name is\" [ITE].",
      "avoid": [
        "greetings",
        "a stack of facts",
        "the ending first"
      ]
    },
    "broll": {
      "amount": "some",
      "kinds": [],
      "favorites": "",
      "notes": ""
    },
    "shots": {
      "framing": "medium",
      "camera": "handheld",
      "punch_ins": "some",
      "notes": ""
    },
