      "attack": 0.3,
      "release": 0.9,
      "crossfade": 3.0,
      "fade_in": 1.5,
      "fade_out": 3.0,
      "dialogue_lufs": null,
      "sources": [],
      "notes": "A soft lo-fi, acoustic or dreamy bed (music-library: Lo-fi / Chill, Acoustic / Calm, Electronic / Soft Dreamy); 60-70% level when a voice or the day's own sounds sit on it [HOL]; it carries the montage parts.",
      "likes": [],
      "avoid": [],
      "theme": null
    },
    "sfx": {
      "gain_db": -18.0,
      "map": {
        "soft_pop": "library/pop_bloop_02",
        "shutter": "library/camera-shutter_click_04",
        "chime": "synth/sparkle",
        "air": "synth/whoosh-soft",
        "ding": "library/ding_confirm_01",
        "bird": "library/songbird_chirp_01"
      },
      "events": {
        "popup": "soft_pop",
        "text": null,
        "transition": "air",
        "reveal": "chime",
        "end": "chime"
      }
    },
    "editing": {
      "max_pause": 0.6,
      "pad_in": 0.12,
      "pad_out": 0.3,
      "blur_pad": true,
      "transitions": "cut",
      "pace": "slow",
      "intro": null,
      "outro": null
    },
    "export": {
      "preset": "social_h264",
      "loudness": -14.0
    },
    "look": {
      "about": "Soft and warm - lifted shadows, gently desaturated, a little golden, a faint grain [HOL saturation down 10-20, shadows raised a little, grain at low strength].",
      "effects": [
        {
          "filter": "hue_lightness_saturation",
          "params": {
            "av.s": 0.86
          }
        },
        {
          "filter": "color",
          "params": {
            "lift_r": 0.035,
            "lift_g": 0.03,
            "lift_b": 0.025,
            "gamma_r": 1.03,
            "gamma_g": 1.01,
            "gamma_b": 0.98,
            "gain_r": 1.02,
            "gain_g": 1.0,
            "gain_b": 0.95
          }
        },
        {
          "filter": "grain",
          "params": {
            "noise": 4,
            "contrast": 100,
            "brightness": 100
          }
        }
      ]
    },
    "taste": "",
    "label": "Aesthetic day-in-the-life",
    "summary": "A calm diary of a day - soft warm colour, small lowercase notes and time stamps, the day's own sounds, gentle music.",
    "kind": "short",
    "tags": [
      "day in the life",
      "vlog",
      "aesthetic",
      "lifestyle",
      "diary",
      "calm",
      "time stamps",
      "b-roll",
      "lo-fi",
      "shorts"
    ],
    "preview": "preview.jpg",
    "recipe": "recipe.md",
    "credits": [
      {
        "file": "preview.jpg",
        "source": "Frames of National Park Service Yosemite b-roll, with this Look's own type; no people",
        "licence": "Public domain (stated on the source page); courtesy National Park Service, no endorsement"
      }
    ],
    "effects": {
      "time_stamp": {
        "kind": "graphic",
        "about": "The time of day in small monospace type on a cream pill, top left (\"7:40 am\"), as a new part of the day starts.",
        "template": "badge",
        "params": {
          "position": [
            0.24,
            0.17
          ]
        },
        "len": 2.6,
        "sfx": null,
        "rules": {
          "triggers": [
            "topic_change",
            "place"
          ],
          "density": {
            "per_min": 5,
            "min_gap_s": 5.0
          },
          "duration_s": [
            2.0,
            3.5
          ],
          "when": "When the hour or the place changes (morning, the drive, the afternoon job, the evening). Use the camera's recorded time when the footage has one (letitedit_timeline_read shows `recorded`); never invent a time - say \"morning\" instead. Params text, lowercase."
        }
      },
      "note": {
        "kind": "text_pop",
        "about": "A short lowercase diary line in an italic serif, just under the middle, fading in and out (\"slow morning at home\"); clear of the area the phone apps cover at the bottom.",
        "size": 0.42,
        "position": [
          0.5,
          0.56
        ],
        "font": "heading",
        "fill": "light",
        "stroke": null,
        "stroke_width": 0,
        "tilt": 0,
        "shadow": true,
        "in": "fade",
        "out": "fade",
        "in_s": 0.45,
        "out_s": 0.45,
        "hold_s": 2.0,
        "sfx": null,
        "rules": {
          "triggers": [
            "topic_change",
            "emphasis",
            "reaction"
          ],
          "density": {
            "per_min": 5,
            "min_gap_s": 5.0
          },
          "placement": {
            "avoid": [
              "face",
              "covered"
            ]
          },
          "duration_s": [
            2.0,
            4.0
          ],
          "never": [
            "over_face",
            "overlapping"
          ],
          "when": "One feeling or fact per moment, five words or fewer, lowercase, written like a diary. Never repeats what the voice says."
        }
      },
      "tiny_sticker": {
        "kind": "popup",
        "about": "A small emoji that floats in beside the thing (coffee, a dog, sparkles), with a soft pop.",
        "size": 0.13,
        "in": "pop",
        "out": "fade",
        "in_s": 0.3,
        "out_s": 0.35,
        "hold_s": 1.4,
        "shadow": true,
        "outline": 0,
        "sfx": "soft_pop",
        "sfx_gain_db": -22,
        "rules": {
          "triggers": [
            "mention",
            "reaction"
          ],
          "density": {
            "per_min": 3,
            "min_gap_s": 8.0
          },
          "placement": {
            "zone": "opposite_face",
            "avoid": [
              "face",
              "captions",
              "covered"
            ]
          },
          "duration_s": [
            1.0,
            2.2
          ],
          "never": [
            "over_face",
            "over_captions"
          ],
          "when": "A cosy detail the viewer sees (the dog, the coffee, the sunset); emoji only, small, one at a time."
        }
      },
      "soft_push": {
        "kind": "zoom_punch",
        "about": "A gentle push-in (105% over 2.5 s) on a still moment.",
        "scale": 1.05,
        "ramp_s": 2.5,
        "rules": {
          "triggers": [
            "cut",
            "pause"
          ],
          "density": {
            "per_min": 6,
            "min_gap_s": 5.0
          },
          "when": "On held shots without camera movement; never on a shot that already moves [HOL hold still when a move adds nothing]."
        }
      },
      "soft_cut": {
        "kind": "transition",
        "about": "A short dissolve between two parts of the day (0.4 s).",
        "transition": {
          "type": "dissolve",
          "len": 0.4
        },
        "rules": {
          "triggers": [
            "topic_change"
          ],
          "density": {
            "per_min": 3,
            "min_gap_s": 10.0
          },
          "when": "Only where time passes (morning to midday, day to evening); hard cuts inside a part."
        }
      },
      "photo_moment": {
        "kind": "sfx",
        "about": "A camera shutter on a still or a held frame.",
        "sfx": "shutter",
        "rules": {
          "triggers": [
            "cut"
          ],
          "density": {
            "per_min": 2,
            "min_gap_s": 15.0
          },
          "when": "When a frame is frozen or a photo is shown."
        }
      },
      "sweet_end": {
        "kind": "sfx",
        "about": "A soft sparkle on the last moment of the day.",
        "sfx": "chime",
        "sfx_gain_db": -20,
        "rules": {
          "triggers": [
            "ending"
          ],
          "density": {
            "per_min": 1
          },
          "when": "The goodnight shot or the last note."
        }
      }
    },
    "fx": {
      "track": "Effects",
      "sfx_track": "Effect sounds",
      "broll_track": "B-roll",
      "density": {
        "per_10s": 4,
        "per_min": null,
        "min_gap_s": null
      },
      "safe_zone": "phone",
      "never": [
        "outside_safe_zone",
