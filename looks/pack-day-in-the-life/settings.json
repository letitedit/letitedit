    },
    "hook": {
      "max_s": 3.0,
      "approaches": [
        "mid_action",
        "result_first",
        "question"
      ],
      "text": {
        "max_words": 6,
        "case": "as_said",
        "position": "center",
        "size": 0.5,
        "fill": "light",
        "stroke": null,
        "stroke_width": 0,
        "font": "heading"
      },
      "rules": "Open on the prettiest moving moment of the day with one lowercase line that says what this is (\"a slow morning at home\"); no greeting, no \"hi guys\". The first time stamp follows within a few seconds.",
