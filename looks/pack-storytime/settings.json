    "effects": {
      "story_label": {
        "kind": "popup",
        "about": "The story's name in one short line near the top, on from the end of the hook to the last line [EOP].",
        "position": [
          0.5,
          0.185
        ],
        "size": 0.62,
        "in": "fade",
        "out": "fade",
        "in_s": 0.35,
        "out_s": 0.3,
        "font": "heading",
        "fill": "brown",
        "stroke": null,
        "stroke_width": 0,
        "outline": 16,
        "outline_color": "cream",
        "shadow": true,
        "sfx": null,
        "rules": {
          "triggers": [
            "hook"
          ],
          "density": {
            "per_min": 1
          },
          "duration_s": [
            5,
            180
          ],
          "never": [
            "over_face"
          ],
          "when": "Once per video. Five to seven words that name the story, not the ending (\"The fan that wouldn't stay fixed\"). Give it as asset {text} and len (to the end of the video)."
        }
      },
      "time_card": {
        "kind": "text_pop",
        "about": "A time or place jump as a short card under the label (\"9 DAYS LATER\", \"THAT NIGHT\").",
        "position": [
          0.5,
          0.29
        ],
        "size": 0.5,
        "font": "heading",
        "fill": "cream",
        "stroke": "brown",
        "stroke_width": 10,
        "tilt": 0,
        "in": "slide_up",
        "out": "fade",
        "hold_s": 1.4,
        "sfx": "paper",
        "rules": {
          "triggers": [
            "topic_change"
          ],
          "density": {
            "per_min": 3,
            "min_gap_s": 8.0
          },
          "duration_s": [
            1.2,
            2.6
          ],
          "never": [
            "over_face",
            "over_captions"
          ],
          "when": "Only where the story jumps in time or place and the words don't say so. Upper case, three words or fewer."
        }
      },
      "slight_zoom": {
        "kind": "zoom_punch",
        "about": "A gentle push-in (108%) that holds to the next cut, on every other cut [EOP; CLU 5-10%].",
        "scale": 1.08,
        "ramp_s": 0.25,
        "rules": {
          "triggers": [
            "cut",
            "emphasis"
          ],
          "density": {
            "per_10s": 3,
            "min_gap_s": 2.0
          },
          "when": "Every other cut, so jump cuts read as a change of framing, not a flicker; not on the turn or the payoff line (tight_zoom has those)."
        }
      },
      "tight_zoom": {
        "kind": "zoom_punch",
        "about": "A closer push (114%) for the turn and the payoff.",
        "scale": 1.14,
        "ramp_s": 0.35,
        "rules": {
          "triggers": [
            "reveal",
            "punchline",
            "emphasis"
          ],
          "density": {
            "per_min": 2,
            "min_gap_s": 10.0
          },
          "when": "The line where it turns and the payoff line; never anywhere else, so it means something."
        }
      },
      "turn_sting": {
        "kind": "sfx",
        "about": "A record scratch right before the twist, with the music dropping out.",
        "sfx": "record_scratch",
        "sfx_offset_s": -0.6,
        "rules": {
          "triggers": [
            "reveal",
            "topic_change"
          ],
          "density": {
            "per_min": 1
          },
          "when": "Once, on the beat before the turn (\"...and then\"); the music drops out under it (protect drop_out). When a time_card marks the turn, give the card this sound instead (sfx record_scratch, sfx_offset_s -0.6) - one beat, one effect."
        }
      },
      "flashback": {
        "kind": "flash",
        "about": "A soft flash with a rewind sound when the story jumps back in time.",
        "color": "cream",
        "len": 0.3,
        "opacity": 0.6,
        "sfx": "rewind",
        "sfx_offset_s": -1.0,
        "rules": {
          "triggers": [
            "topic_change"
          ],
          "density": {
            "per_min": 1
          },
          "when": "Only when the telling goes back in time (a flashback); at most once."
        }
      },
      "payoff_chime": {
        "kind": "sfx",
        "about": "A soft chime right after the payoff word.",
        "sfx": "chime",
        "sfx_offset_s": 0.15,
        "rules": {
          "triggers": [
            "reveal",
            "ending",
            "punchline"
          ],
          "density": {
            "per_min": 1
          },
          "when": "After the payoff line lands, never over its words."
        }
      },
      "thing_pop": {
        "kind": "popup",
        "about": "An occasional sticker of a key object in the story.",
        "size": 0.2,
        "in": "pop",
        "out": "shrink",
        "hold_s": 1.2,
        "outline": 10,
        "sfx": "pop_hi",
        "rules": {
          "triggers": [
            "mention"
          ],
          "density": {
            "per_min": 3,
            "min_gap_s": 8.0
          },
          "placement": {
            "zone": [
              0.78,
              0.4
            ],
            "avoid": [
              "face",
              "captions",
              "covered"
            ]
          },
          "duration_s": [
            1.0,
            2.2
          ],
          "never": [
            "over_face",
            "over_captions"
          ],
          "when": "The two or three objects the story turns on (the broken part, the gift); not every noun."
        }
      },
      "cutaway": {
        "kind": "broll",
        "about": "A short cutaway to what is being described, the voice carrying on.",
        "fit": "cover",
        "len": 2.0,
        "sfx": null,
        "rules": {
          "triggers": [
            "mention",
            "reveal"
          ],
          "density": {
            "per_min": 4,
            "min_gap_s": 6.0
          },
          "duration_s": [
            1.2,
            4.0
          ],
          "never": [
            {
              "first_s": 2.0
            }
          ],
          "when": "When there is footage of exactly what is told, within 1.5 s of the words [MON]; never over the teller's reaction at the turn or the payoff."
        }
      }
    },
    "fx": {
      "track": "Effects",
      "sfx_track": "Effect sounds",
      "broll_track": "B-roll",
      "density": {
        "per_10s": 3,
        "per_min": null,
        "min_gap_s": 1.5
      },
      "safe_zone": "phone",
      "never": [
        "outside_safe_zone",
        "overlapping"
      ],
      "rhythm": "A slight zoom on every other cut; labels only where time or place jumps; one sting at the turn."
    },
    "popups": {
      "track": null,
      "sfx_track": null,
      "min_gap_s": 2.0,
      "max_total": null,
      "entries": []
    },
    "hook": {
      "max_s": 3.0,
      "approaches": [
        "stakes",
        "question",
        "quote",
        "result_first"
      ],
      "text": {
        "max_words": 7,
        "case": "as_said",
        "item": {
          "graphic": {
            "template": "popup",
            "params": {
              "text": "{text}",
              "x": 0.5,
              "y": 0.185,
              "size": 0.62,
              "in": "fade",
              "out": "fade",
              "font": "heading",
              "fill": "brown",
              "stroke_width": 0,
              "outline": 16,
              "outline_color": "cream",
              "shadow": true
            }
          }
        }
      },
      "rules": "Open on the line that makes you need the rest (the problem, the strangest moment, the question) - no greeting [EOP, JH]. The story label is the hook text and stays up for the whole video, so the hook itself needs no other text.",
      "avoid": [
        "greetings",
        "so this happened",
        "backstory first",
        "logo cards"
      ]
    },
    "broll": {
      "amount": "some",
      "kinds": [],
      "favorites": "",
      "notes": ""
    },
    "shots": {
      "framing": "medium",
      "camera": "handheld",
      "punch_ins": "some",
      "notes": ""
    },
    "signature": {
      "touches": []
    },
