        "sfx": "bass_hit",
        "sfx_offset_s": -0.017,
        "rules": {
          "triggers": [
            "hook",
            "topic_change",
            "ending"
          ],
          "density": {
            "per_10s": 1,
            "min_gap_s": 4.0
          },
          "placement": {
            "zone": "center",
            "avoid": [
              "covered"
            ]
          },
          "duration_s": [
            0.5,
            2.0
          ],
          "when": "The opening downbeat and maybe the last; one or two words, upper case."
        }
      },
      "beat_flash": {
        "kind": "flash",
        "about": "A white flash on a big downbeat or the drop (0.12 s).",
        "color": "light",
        "len": 0.12,
        "opacity": 0.75,
        "sfx": null,
        "rules": {
          "triggers": [
            "cut",
            "reveal"
          ],
          "density": {
            "per_10s": 2,
            "min_gap_s": 1.0
          },
          "when": "The drop and two or three big downbeats; never more than three flashes a second [RES], never on every beat."
        }
      },
      "drop_shake": {
        "kind": "shake",
        "about": "A hard camera shake on the drop, with an impact.",
        "amount": 0.7,
        "len": 0.35,
        "sfx": "impact",
        "sfx_offset_s": -0.017,
        "rules": {
          "triggers": [
            "reveal",
            "cut"
          ],
          "density": {
            "per_min": 4,
            "min_gap_s": 6.0
          },
          "when": "The drop, and at most one other hit."
        }
      },
      "zoom_pulse": {
        "kind": "zoom_punch",
        "about": "A quick zoom pulse in time with a beat (0.25 s, 112%).",
        "scale": 1.12,
        "ramp_s": 0.06,
        "len": 0.25,
        "rules": {
          "triggers": [
            "cut",
            "emphasis"
          ],
          "density": {
            "per_10s": 3,
            "min_gap_s": 1.0
          },
          "duration_s": [
            0.15,
            0.4
          ],
          "when": "Inside a held shot during the build, on alternate beats; not every beat."
        }
      },
      "glitch_cut": {
        "kind": "glitch",
        "about": "A digital glitch into a cut (0.2 s).",
        "amount": 0.7,
        "len": 0.2,
        "sfx": "glitch",
        "rules": {
          "triggers": [
            "cut",
            "topic_change"
          ],
          "density": {
            "per_min": 4,
            "min_gap_s": 5.0
          },
          "when": "A change of section in the song (verse to chorus). Rotate with flashes; never both on one cut."
        }
      },
      "riser_build": {
        "kind": "sfx",
        "about": "A riser that ends exactly on the drop.",
        "sfx": "riser",
        "sfx_offset_s": -1.86,
        "rules": {
          "triggers": [
            "reveal"
          ],
          "density": {
            "per_min": 1
          },
          "when": "Only when the song's own build is weak; it ends on the drop."
        }
      },
      "whoosh_cut": {
        "kind": "whoosh",
        "about": "A whoosh into a cut between two moving shots.",
        "sfx": "whoosh",
        "sfx_offset_s": -0.14,
        "rules": {
          "triggers": [
            "cut"
          ],
          "density": {
            "per_10s": 1,
            "min_gap_s": 4.0
          },
          "when": "Between two shots moving in the same direction (a match on motion); sparingly."
        }
      },
      "transition_wipe": {
        "kind": "transition",
        "about": "A short wipe on a section change (0.2 s) [EDS].",
        "transition": {
          "type": "bar_horizontal",
          "len": 0.2
        },
        "rules": {
          "triggers": [
            "topic_change"
          ],
          "density": {
            "per_min": 2,
            "min_gap_s": 8.0
          },
          "when": "At most once or twice; hard cuts are the default."
        }
      }
    },
