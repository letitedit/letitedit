      "title_slam": {
        "kind": "text_pop",
        "about": "One huge condensed word on a downbeat (the place, the theme), white, no tilt.",
        "size": 0.85,
        "font": "heading",
        "fill": "light",
        "stroke": null,
        "stroke_width": 0,
        "tilt": 0,
        "shadow": true,
