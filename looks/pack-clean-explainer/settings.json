        "source": "Original preview imagery; hands, objects, places and titles only",
        "licence": "Original letitedit footage: hands, objects, places and titles only; no faces"
      }
    ],
    "effects": {
      "chapter": {
        "kind": "graphic",
        "about": "A chapter card (number and name on a band) over the first shot of each part.",
        "template": "chapter_card",
        "len": 3.0,
        "sfx": "swish",
        "rules": {
          "triggers": [
            "topic_change"
          ],
          "density": {
            "per_min": 3,
            "min_gap_s": 20.0
          },
          "duration_s": [
            2.5,
            4.0
          ],
          "when": "The start of each part; three to five parts [CLU], named like the chapter markers (first at 0:00, each at least 10 s [HED, YT]; in a short video parts of 20-30 s are fine). Params number, title."
        }
      },
      "label": {
        "kind": "popup",
        "about": "A short label naming what is on screen (six words at most, sentence case) [CLU].",
        "size": 0.32,
        "position": "upper_left",
        "in": "fade",
        "out": "fade",
        "in_s": 0.2,
        "out_s": 0.2,
        "hold_s": 2.4,
        "font": "heading",
        "fill": "dark",
        "stroke_width": 0,
        "outline": 14,
        "outline_color": "paper",
        "shadow": true,
        "sfx": null,
        "rules": {
          "triggers": [
            "mention",
            "list_item"
          ],
          "density": {
            "per_min": 4,
            "min_gap_s": 8.0
          },
          "duration_s": [
            1.5,
            3.5
          ],
          "never": [
            "overlapping"
          ],
          "when": "A part, a tool or a value the viewer must recognise, 250-400 ms after it appears [CLU]; on screen 1.5-3 s [OVS]. Give asset {text}; exact values as recorded."
        }
      },
      "point_at": {
        "kind": "graphic",
        "about": "A ring and a line pointing at a fixed spot in the shot, with its label.",
        "template": "callout",
        "len": 3.0,
        "sfx": null,
        "rules": {
          "triggers": [
            "mention"
          ],
          "density": {
            "per_min": 3,
            "min_gap_s": 10.0
          },
          "duration_s": [
            2.0,
            4.0
          ],
          "when": "The exact part being talked about, when it holds still; params text, target_x, target_y. A moving part - letitedit_annotate (it tracks). One pointer at a time [modes]."
        }
      },
      "step_label": {
        "kind": "popup",
        "about": "\"Step 2 of 4: tighten the set screw\" in the top-left while the step plays.",
        "size": 0.42,
        "position": [
          0.25,
          0.2
        ],
        "in": "slide_right",
        "out": "fade",
        "in_s": 0.3,
        "out_s": 0.25,
        "hold_s": 4.0,
        "font": "heading",
        "fill": "light",
        "stroke": "dark",
        "stroke_width": 6,
        "shadow": true,
        "sfx": "paper",
        "rules": {
          "triggers": [
            "list_item"
          ],
          "density": {
            "per_min": 4,
            "min_gap_s": 10.0
          },
          "duration_s": [
            3.0,
            10.0
          ],
          "when": "Each step's spoken start, worded like the chapter, numbered as promised [modes]; within a second of it. A short step may follow 10 s after the one before."
        }
      },
      "key_point": {
        "kind": "text_pop",
        "about": "The one sentence to remember, in a few words, centred, with a soft chime.",
        "size": 0.62,
        "font": "heading",
        "fill": "light",
        "stroke": "dark",
        "stroke_width": 8,
        "tilt": 0,
        "in": "fade",
        "out": "fade",
        "hold_s": 2.2,
        "sfx": "chime",
        "rules": {
          "triggers": [
            "emphasis",
            "reveal"
          ],
          "density": {
            "per_min": 1,
            "min_gap_s": 45.0
          },
          "duration_s": [
            1.8,
            3.5
          ],
          "when": "The takeaway of a part, at most once per part; exactly what was said, shortened, never a new claim."
        }
      },
      "gentle_push": {
        "kind": "zoom_punch",
        "about": "A slow, small push-in (106%) as an attention cue [HED 3.5%, CLU 5-10%].",
        "scale": 1.06,
        "ramp_s": 0.6,
        "rules": {
          "triggers": [
            "emphasis",
            "question",
            "topic_change"
          ],
          "density": {
            "per_min": 3,
            "min_gap_s": 15.0
          },
          "when": "About every 25-45 s on a long talking stretch [HED], on the line that matters; never during a step the viewer must copy [modes]."
        }
      },
      "fact_number": {
        "kind": "graphic",
        "about": "A number that matters counting up with its label.",
        "template": "big_number",
        "len": 3.0,
        "sfx": "chime",
        "rules": {
          "triggers": [
            "number"
          ],
          "density": {
            "per_min": 1,
            "min_gap_s": 30.0
          },
          "duration_s": [
            2.0,
            4.0
          ],
          "when": "A figure the explanation turns on (a cost, a size, a time); params value, prefix, suffix, label."
        }
      },
      "section_dissolve": {
        "kind": "transition",
        "about": "A short dissolve between parts (0.3 s) [CLU].",
        "transition": {
          "type": "dissolve",
          "len": 0.3
        },
        "rules": {
          "triggers": [
            "topic_change"
          ],
          "density": {
            "per_min": 2,
            "min_gap_s": 30.0
          },
          "when": "Between chapters only; cuts everywhere else."
        }
      },
      "cutaway": {
        "kind": "broll",
        "about": "A shot of what is being explained, the voice carrying on.",
        "fit": "blur_pad",
        "len": 3.0,
        "sfx": null,
        "rules": {
          "triggers": [
            "mention",
            "list_item"
          ],
          "density": {
            "per_min": 4,
            "min_gap_s": 8.0
          },
          "duration_s": [
            2.0,
            6.0
          ],
          "when": "Proof and orientation shots; never over a step being copied, never over the warning or the why [modes]."
        }
      }
    },
    "fx": {
      "track": "Effects",
      "sfx_track": "Effect sounds",
      "broll_track": "B-roll",
      "density": {
        "per_10s": 2,
        "per_min": 8,
        "min_gap_s": 3.0
      },
      "safe_zone": null,
      "never": [
        "overlapping"
      ],
      "rhythm": "Something changes every 10-20 s at the start and every 25-40 s later; labels where they make things clearer."
    },
    "popups": {
      "track": null,
      "sfx_track": null,
      "min_gap_s": 4.0,
      "max_total": null,
      "entries": []
    },
    "hook": {
      "max_s": 8.0,
      "approaches": [
        "result_first",
        "question",
        "stakes",
        "number"
      ],
      "text": {
        "max_words": 8,
        "case": "as_said",
        "position": "bottom",
        "size": 0.5,
        "fill": "light",
        "stroke": "dark",
        "stroke_width": 6,
        "font": "heading"
      },
      "rules": "The outcome in the first 0-5 s, then the promise and the shape (\"in four steps\") [CLU, JH]. No channel intro, no \"in this video\" [JH]. A cold open may show the result working for a few seconds before the title.",
      "avoid": [
        "greetings",
        "channel intros",
        "a long title sequence"
      ]
    },
    "broll": {
      "amount": "some",
      "kinds": [],
      "favorites": "",
      "notes": ""
    },
    "shots": {
      "framing": "medium",
      "camera": "handheld",
      "punch_ins": "some",
      "notes": ""
    },
    "signature": {
      "touches": []
    },
    "measured": {},
    "provenance": {
      "made_by": "letitedit style library, wave 1",
