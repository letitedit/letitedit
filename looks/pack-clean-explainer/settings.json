      "pace": "medium",
      "intro": null,
      "outro": null
    },
    "export": {
      "preset": "high_quality_h264",
      "loudness": -14.0
    },
    "look": {
      "about": "Clean and true to life - colours as they are, a touch of contrast; shots matched to each other.",
      "effects": [
        {
          "filter": "hue_lightness_saturation",
          "params": {
            "av.s": 1.03
          }
        }
      ]
    },
    "taste": "",
    "label": "Clean explainer",
    "summary": "Calm, clear teaching - chapter cards, labels that point at things, one idea at a time, music only between parts.",
    "kind": "long",
    "tags": [
      "explainer",
      "educational",
      "tutorial",
      "how-to",
      "long form",
      "chapters",
      "clean",
      "youtube"
    ],
    "preview": "preview.jpg",
    "recipe": "recipe.md",
    "credits": [
      {
        "file": "assets/ding_confirm_04.mp3",
        "source": "Kenney.nl: Kenney interface-sounds: Audio\\confirmation_004.ogg (https://kenney.nl/assets/interface-sounds); copy of ding_confirm_04.mp3 from the local sound library (04 Dings & Sparkles)",
        "licence": "CC0 1.0 (public domain)"
      },
      {
        "file": "assets/whoosh_fast_02.mp3",
        "source": "Freesound.org: swosh-22.flac by qubodup (freesound #60009) (https://freesound.org/people/qubodup/sounds/60009/); copy of whoosh_fast_02.mp3 from the local sound library (08 Whooshes & Transitions)",
        "licence": "CC0 1.0 (Creative Commons 0)"
      },
