      "merge_gap": 4.0,
      "attack": 0.3,
      "release": 0.9,
      "crossfade": 3.0,
      "fade_in": 1.5,
      "fade_out": 3.0,
      "dialogue_lufs": null,
      "sources": [],
      "notes": "Light, without lyrics or busy melody; up in the intro, between chapters and on the result; out (or at -28 dB) under steps.",
      "likes": [],
      "avoid": [],
      "theme": null
    },
    "sfx": {
      "gain_db": -20.0,
      "map": {
        "chime": "assets/ding_confirm_04.mp3",
        "swish": "assets/whoosh_fast_02.mp3",
