{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letitedit.app/studio/1/kinds/match.schema.json",
  "title": "match: where a finished video's footage came from",
  "description": "Best effort. Compares the video's pictures (and sound, when it has the original's) against indexed footage. Local only.",
  "$defs": {
    "inputs": {
      "type": "object",
      "required": ["video"],
      "properties": {
        "video": {"$ref": "../common.schema.json#/$defs/abs_path"},
        "folders": {"type": "array", "items": {"$ref": "../common.schema.json#/$defs/abs_path"}, "description": "Search only footage indexed from these folders. Absent: everything indexed."},
        "max_candidates": {"type": "integer", "minimum": 1, "maximum": 10, "default": 3},
        "min_confidence": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.5}
      }
    },
    "output": {
      "type": "object",
      "required": ["verdict", "matched_share", "segments"],
      "properties": {
        "verdict": {"type": "string", "enum": ["matched", "partial", "unknown"], "description": "unknown: nothing reached min_confidence (the footage may not be indexed, or is not ours)."},
        "matched_share": {"type": "number", "minimum": 0, "maximum": 1, "description": "Share of the video's running time with a candidate."},
        "video_duration_s": {"$ref": "../common.schema.json#/$defs/seconds"},
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["video_in", "video_out", "candidates"],
            "properties": {
              "video_in": {"$ref": "../common.schema.json#/$defs/seconds"},
              "video_out": {"$ref": "../common.schema.json#/$defs/seconds"},
              "candidates": {
                "type": "array",
                "description": "Best first; empty: unknown.",
                "items": {
                  "type": "object",
                  "required": ["file_id", "path", "in", "out", "confidence", "method"],
                  "properties": {
                    "file_id": {"$ref": "../common.schema.json#/$defs/file_id"},
                    "path": {"$ref": "../common.schema.json#/$defs/abs_path"},
                    "moment_ids": {"type": "array", "items": {"$ref": "../common.schema.json#/$defs/moment_id"}},
                    "in": {"$ref": "../common.schema.json#/$defs/seconds"},
                    "out": {"$ref": "../common.schema.json#/$defs/seconds"},
                    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                    "method": {"type": "string", "enum": ["picture", "sound", "words", "picture_and_sound"]}
                  }
                }
              }
            }
          }
        },
        "searched": {"type": "object", "properties": {"files": {"type": "integer"}, "folders": {"type": "array", "items": {"type": "string"}}}}
      }
    }
  }
}
