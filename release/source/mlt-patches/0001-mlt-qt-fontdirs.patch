diff --git a/src/modules/qt/common.cpp b/src/modules/qt/common.cpp
index 148c3dbb..18192024 100644
--- a/src/modules/qt/common.cpp
+++ b/src/modules/qt/common.cpp
@@ -18,14 +18,67 @@
 
 #include "common.h"
 #include <QApplication>
+#include <QDirIterator>
+#include <QFontDatabase>
 #include <QImageReader>
 #include <QLocale>
+#include <QSet>
 
 #if defined(Q_OS_UNIX) && !defined(Q_OS_MAC) && !defined(Q_OS_ANDROID)
 #include <X11/Xlib.h>
 #include <cstdlib>
 #endif
 
+// letitedit: load font files from folders into this process (QFontDatabase::addApplicationFont), so text renders
+// in fonts that Windows did not load at sign-in (per-user installs are sometimes not exposed to processes).
+// LETITEDIT_FONT_DIRS lists folders separated by ';' (searched recursively for .ttf/.otf/.ttc/.otc). When it is
+// not set, the per-user font folder (%LOCALAPPDATA%\Microsoft\Windows\Fonts) is used; an empty value loads nothing.
+// A file name already loaded from an earlier folder is skipped. Runs once per process, the first time a text service
+// (qtext producer/filter, kdenlivetitle) starts, and only when this module created the application: a host
+// application such as Shotcut loads its own fonts.
+static bool s_mltCreatedApp = false;
+
+void loadShotcutAiFontsIfNeeded(mlt_service service)
+{
+    static bool done = false;
+    if (done || !s_mltCreatedApp)
+        return;
+    done = true;
+    QStringList dirs;
+    if (qEnvironmentVariableIsSet("LETITEDIT_FONT_DIRS")) {
+        dirs = qEnvironmentVariable("LETITEDIT_FONT_DIRS").split(QLatin1Char(';'), Qt::SkipEmptyParts);
+    } else {
+#if defined(Q_OS_WIN)
+        const QString local = qEnvironmentVariable("LOCALAPPDATA");
+        if (!local.isEmpty())
+            dirs << local + QStringLiteral("/Microsoft/Windows/Fonts");
+#endif
+    }
+    QSet<QString> seen;
+    int loaded = 0, failed = 0;
+    for (const QString &dir : std::as_const(dirs)) {
+        QDirIterator it(dir.trimmed(),
+                        {QStringLiteral("*.ttf"), QStringLiteral("*.otf"), QStringLiteral("*.ttc"),
+                         QStringLiteral("*.otc")},
+                        QDir::Files,
+                        QDirIterator::Subdirectories);
+        while (it.hasNext()) {
+            const QString path = it.next();
+            const QString key = it.fileName().toLower();
+            if (seen.contains(key))
+                continue;
+            seen.insert(key);
+            if (QFontDatabase::addApplicationFont(path) >= 0)
+                ++loaded;
+            else
+                ++failed;
+        }
+    }
+    if (!dirs.isEmpty())
+        mlt_log_verbose(service, "letitedit fonts: loaded %d files (%d failed) from %s%c", loaded, failed,
+                        dirs.join(QLatin1Char(';')).toUtf8().constData(), 10);
+}
+
 bool createQApplicationIfNeeded(mlt_service service)
 {
     if (!qApp) {
@@ -59,6 +112,7 @@ bool createQApplicationIfNeeded(mlt_service service)
 #if QT_VERSION >= QT_VERSION_CHECK(6, 0, 0)
         QImageReader::setAllocationLimit(1024);
 #endif
+        s_mltCreatedApp = true;
     }
     return true;
 }
